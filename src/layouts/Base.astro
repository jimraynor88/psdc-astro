---
interface Props {
  title?: string;
  description?: string;
  accent?: string;
  accent2?: string;
  visual?: string;
}
const {
  title = 'PSdC — Puro Sonido de Club',
  description = '',
  accent = '#53c8ff',
  accent2 = '#2b6bff',
  visual = 'vinyl',
} = Astro.props;
const site = Astro.site!;
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="alternate" type="application/rss+xml" title="PSdC" href={new URL('/feed.xml', site)}>
</head>
<body class="v-{visual}" style="--acc:{accent};--acc2:{accent2}">
  <slot />
</body>
</html>
